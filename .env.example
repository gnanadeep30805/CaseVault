# CaseVault environment configuration
# Copy to backend/.env for local development. Never commit real secrets.

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API. Keep 1 behind a single proxy,
# or 0 when running the API directly. Affects rate limiting and client IPs.
TRUST_PROXY=1
JSON_BODY_LIMIT=10mb

# ---- Secrets (required in production) ----------------------------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
# 32-byte key used to derive the AES-256-GCM document encryption key.
# openssl rand -hex 32
DOCUMENT_STORAGE_KEY=replace_with_32_byte_hex_document_storage_key
# Maximum accepted upload size in bytes (default 10485760 = 10 MiB).
DOCUMENT_MAX_SIZE=10485760

# ---- Multi-factor authentication ---------------------------------------------
# Base32 TOTP seed used when a user enrols a new authenticator.
MFA_SECRET=replace_with_base32_totp_secret
# Set to false to disable the demo MFA code endpoint. It is always disabled
# automatically when NODE_ENV=production.
ALLOW_DEMO_MFA=true
# Optional fixed 6-digit code for automated testing only.
DEMO_MFA_CODE=

# ---- Storage (default: encrypted files on local disk) -------------------------
# Absolute paths. The JSON file holds metadata; documents are AES-256-GCM
# encrypted .cvault files in the storage directory.
# Defaults to backend/data/casevault.json and backend/data/secure-documents.
CASEVAULT_DATA_FILE=
CASEVAULT_STORAGE_DIRECTORY=

# ---- Password reset ----------------------------------------------------------
# bcrypt hash of the password given to every seeded demo account.
# Demo accounts are listed in the README.
DEV_PASSWORD_HASH=replace_with_bcrypt_hash

# ---- Rate limiting -----------------------------------------------------------
# Window applies to both buckets. Lower RATE_LIMIT_AUTH_MAX when exposing the
# API to untrusted clients; the automated smoke suite raises these itself.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=300

# ---- Outbound email (optional) ----------------------------------------------
# When SMTP_HOST, SMTP_USER and SMTP_PASS are all set, verification codes are
# delivered over SMTP. Otherwise every message is written to the mailOutbox
# collection in the data file. Requires the optional `nodemailer` dependency.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CaseVault <noreply@casevault.local>

# ---- AI provider (optional) --------------------------------------------------
# Path to a module exporting a provider hook. When unset, CaseVault uses the
# built-in deterministic local analyser, which never calls an external service.
AI_PROVIDER_HOOK=

# ---- Frontend ----------------------------------------------------------------
# Set in frontend/.env. Leave unset to use the Vite dev proxy on /api.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Not used by the JSON/encrypted-file deployment. Listed so stale local
# configuration does not confuse: DATABASE_URL, REDIS_URL, MINIO_*.
